CREATE TABLE Flashcard (
    id TEXT NOT NULL PRIMARY KEY,       -- UUID
    deckId TEXT NOT NULL,              -- FK → Decks.id

    word TEXT NOT NULL,                 -- Palabra clave ("compelling")
    meaning TEXT NOT NULL,              -- Explicación en inglés ("convincing")
    translation TEXT,                   -- Traducción en español ("convincente")

    phonetic TEXT,                      -- Pronunciación /kəmˈpelɪŋ/
    partOfSpeech TEXT,                  -- noun, verb, adjective, phrasal_verb, etc.
    type TEXT,                          -- word, phrase, idiom, phrasal_verb, sentence

    note TEXT,                          -- Nota personal / tips de gramática
    createdAt INTEGER NOT NULL,        -- Fecha de creación
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,
    originDeviceId TEXT NOT NULL,
    lastModifiedByDeviceId TEXT NOT NULL,
    versionLamport INTEGER NOT NULL,

    FOREIGN KEY (deckId) REFERENCES Deck(id) ON DELETE CASCADE
);

CREATE INDEX idx_Flashcard_deckId ON Flashcard(deckId);
CREATE INDEX idx_Flashcard_deletedAt ON Flashcard(deletedAt);

create:
INSERT OR REPLACE INTO Flashcard (
    id,
    deckId,
    word,
    meaning,
    translation,
    phonetic,
    partOfSpeech,
    type,
    note,
    createdAt,
    updatedAt,
    deletedAt,
    originDeviceId,
    lastModifiedByDeviceId,
    versionLamport
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

all:
SELECT * FROM Flashcard;

findById:
SELECT * FROM Flashcard WHERE id = ?;

selectByDeck:
SELECT * FROM Flashcard WHERE deckId = ?;

flashcardWithExamples:
SELECT
    f.*,
    e.id AS exampleId,
    e.text AS exampleText,
    e.translation AS exampleTranslation,
    e.type AS exampleType
FROM Flashcard f
LEFT JOIN FlashcardExample e ON f.id = e.flashcardId
WHERE f.id = :flashcardId;

flashcardsToReviewByDeck:
SELECT f.*, rp.*
FROM Flashcard f
LEFT JOIN ReviewProjection rp ON f.id = rp.flashcardId
WHERE f.deckId = :deckId AND (rp.nextReviewAt IS NULL OR rp.nextReviewAt <= :now);

flashcardsWithReview:
SELECT f.*, rp.nextReviewAt
FROM Flashcard f
LEFT JOIN ReviewProjection rp ON f.id = rp.flashcardId
WHERE f.deckId = :deckId;
