CREATE TABLE Flashcard (
    id TEXT NOT NULL,                   -- UUID
    deckId TEXT NOT NULL,               -- FK → Decks.id

    word TEXT NOT NULL,                 -- Palabra clave ("compelling")
    meaning TEXT NOT NULL,              -- Explicación en inglés ("convincing")
    translation TEXT,                   -- Traducción en español ("convincente")

    phonetic TEXT,                      -- Pronunciación /kəmˈpelɪŋ/
    partOfSpeech TEXT,                  -- noun, verb, adjective, phrasal_verb, etc.
    type TEXT,                          -- word, phrase, idiom, phrasal_verb, sentence

    note TEXT,                          -- Nota personal / tips de gramática
    register TEXT,
    levelBand TEXT,
    domain TEXT,
    lemma TEXT,
    whyUseful TEXT,
    usagePattern TEXT,
    irregularFormsJson TEXT,
    collocationsJson TEXT,
    commonMistake TEXT,
    confusableWithJson TEXT,
    clozeSentence TEXT,
    sourceContext TEXT,
    warningsJson TEXT,
    studyCardsJson TEXT,
    qualityChecksJson TEXT,
    createdAt INTEGER NOT NULL,        -- Fecha de creación
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,
    enrichmentStatus TEXT NOT NULL DEFAULT 'ENRICHED',

    PRIMARY KEY (id),
    FOREIGN KEY (deckId) REFERENCES Deck(id) ON DELETE CASCADE
);

CREATE INDEX idx_Flashcard_deck_deleted ON Flashcard(deckId, deletedAt);
CREATE INDEX idx_Flashcard_deleted ON Flashcard(deletedAt);
CREATE INDEX idx_Flashcard_createdAt ON Flashcard(createdAt DESC);

-- Every flashcard the SRS is allowed to schedule: alive and with a back face.
-- The due queries select from here so neither predicate can be forgotten again.
CREATE VIEW StudiableFlashcard AS
SELECT * FROM Flashcard
WHERE deletedAt IS NULL
  AND enrichmentStatus = 'ENRICHED';

create:
INSERT OR REPLACE INTO Flashcard (
    id,
    deckId,
    word,
    meaning,
    translation,
    phonetic,
    partOfSpeech,
    type,
    note,
    register,
    levelBand,
    domain,
    lemma,
    whyUseful,
    usagePattern,
    irregularFormsJson,
    collocationsJson,
    commonMistake,
    confusableWithJson,
    clozeSentence,
    sourceContext,
    warningsJson,
    studyCardsJson,
    qualityChecksJson,
    createdAt,
    updatedAt,
    deletedAt,
    enrichmentStatus
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllFlashcards:
DELETE FROM Flashcard;

all:
SELECT * FROM Flashcard
WHERE deletedAt IS NULL;

findById:
SELECT * FROM Flashcard
WHERE id = ?;

selectByDeck:
SELECT * FROM Flashcard
WHERE deckId = ?
  AND deletedAt IS NULL;

existsExactDuplicate:
SELECT EXISTS(
  SELECT 1 FROM Flashcard
  WHERE deckId = :deckId
    AND deletedAt IS NULL
    AND lower(trim(word)) = :normalizedExpression
    AND lower(trim(translation)) = :normalizedIntendedMeaningEs
    AND lower(trim(type)) = :normalizedNoteType
);

existsExpressionInDeck:
SELECT EXISTS(
  SELECT 1 FROM Flashcard
  WHERE deckId = :deckId
    AND deletedAt IS NULL
    AND lower(trim(word)) = :normalizedExpression
);

-- Note: f.* and rp.* both expose `updatedAt`; SQLDelight disambiguates the ReviewProjection
-- one as `updatedAt_` in the generated row class. No mapper reads it, so the collision is inert.
flashcardWithExamples:
SELECT
    f.*,
    e.id AS exampleId,
    e.text AS exampleText,
    e.translation AS exampleTranslation,
    e.type AS exampleType,
    rp.*
FROM Flashcard f
LEFT JOIN FlashcardExample e
  ON f.id = e.flashcardId
  AND e.deletedAt IS NULL
LEFT JOIN ReviewProjection rp
  ON f.id = rp.flashcardId
WHERE f.id = :flashcardId
  AND f.deletedAt IS NULL;

-- exampleText/exampleTranslation come from a LEFT JOIN against the single earliest
-- non-deleted FlashcardExample row (tie-broken by id), matched by id so both columns are
-- guaranteed to come from the SAME example row. This is a 1:1 match by construction (fe.id is
-- a primary key), so it cannot fan out into duplicate session rows the way joining directly
-- against FlashcardExample would. A plain correlated-subquery-per-column was tried first, but
-- SQLDelight infers a subquery's nullability from its source column and does not detect that a
-- zero-row match makes the whole subquery NULL, so it generated non-null String fields that
-- crashed with NPE on cards without an example. The LEFT JOIN form is inferred correctly,
-- matching how rp.* is already nullable below.
flashcardsToReviewByDeck:
SELECT f.*,
    fe.text AS exampleText,
    fe.translation AS exampleTranslation,
    rp.*
FROM StudiableFlashcard f
LEFT JOIN FlashcardExample fe
  ON fe.id = (
      SELECT e.id FROM FlashcardExample e
      WHERE e.flashcardId = f.id AND e.deletedAt IS NULL
      ORDER BY e.createdAt, e.id LIMIT 1
  )
LEFT JOIN ReviewProjection rp
  ON f.id = rp.flashcardId
WHERE f.deckId = :deckId
  AND (rp.nextReviewAt IS NULL OR rp.nextReviewAt <= :now);

-- All-decks variant of flashcardsToReviewByDeck: same projection, no deckId filter.
-- Backs the global "study everything due today" session (Dashboard "Estudiar ahora").
-- LEFT JOIN includes never-reviewed cards (no ReviewProjection row): NULL nextReviewAt means due now.
flashcardsToReviewAllDecks:
SELECT f.*,
    fe.text AS exampleText,
    fe.translation AS exampleTranslation,
    rp.*
FROM StudiableFlashcard f
LEFT JOIN FlashcardExample fe
  ON fe.id = (
      SELECT e.id FROM FlashcardExample e
      WHERE e.flashcardId = f.id AND e.deletedAt IS NULL
      ORDER BY e.createdAt, e.id LIMIT 1
  )
LEFT JOIN ReviewProjection rp
  ON f.id = rp.flashcardId
WHERE (rp.nextReviewAt IS NULL OR rp.nextReviewAt <= :now);

-- Note: f.* and rp.* both expose `updatedAt`; SQLDelight disambiguates the ReviewProjection
-- one as `updatedAt_` in the generated row class. No mapper reads it, so the collision is inert.
flashcardsWithReview:
SELECT f.*,
    fe.text AS exampleText,
    fe.translation AS exampleTranslation,
    rp.*
FROM Flashcard f
LEFT JOIN FlashcardExample fe
  ON fe.id = (
      SELECT e.id FROM FlashcardExample e
      WHERE e.flashcardId = f.id AND e.deletedAt IS NULL
      ORDER BY e.createdAt, e.id LIMIT 1
  )
LEFT JOIN ReviewProjection rp
  ON f.id = rp.flashcardId
WHERE f.deckId = :deckId
  AND f.deletedAt IS NULL;

countDueFlashcards:
SELECT COUNT(*)
FROM StudiableFlashcard f
LEFT JOIN ReviewProjection rp
  ON f.id = rp.flashcardId
WHERE rp.nextReviewAt IS NULL OR rp.nextReviewAt <= :now;

update:
UPDATE Flashcard
SET word = :word,
    meaning = :meaning,
    translation = :translation,
    phonetic = :phonetic,
    partOfSpeech = :partOfSpeech,
    type = :type,
    note = :note,
    register = :register,
    levelBand = :levelBand,
    domain = :domain,
    lemma = :lemma,
    whyUseful = :whyUseful,
    usagePattern = :usagePattern,
    irregularFormsJson = :irregularFormsJson,
    collocationsJson = :collocationsJson,
    commonMistake = :commonMistake,
    confusableWithJson = :confusableWithJson,
    clozeSentence = :clozeSentence,
    sourceContext = :sourceContext,
    warningsJson = :warningsJson,
    updatedAt = :updatedAt
WHERE id = :id
  AND deletedAt IS NULL;

setEnrichmentStatus:
UPDATE Flashcard
SET enrichmentStatus = :enrichmentStatus,
    updatedAt = :updatedAt
WHERE id = :id
  AND deletedAt IS NULL;

softDelete:
UPDATE Flashcard
SET deletedAt = :now
WHERE id = :id
  AND deletedAt IS NULL;

softDeleteExamplesByFlashcard:
UPDATE FlashcardExample
SET deletedAt = :now
WHERE flashcardId = :flashcardId
  AND deletedAt IS NULL;

restoreFlashcard:
UPDATE Flashcard
SET deletedAt = NULL
WHERE id = :id
  AND deletedAt = :deletedAt;

restoreExamplesByFlashcard:
UPDATE FlashcardExample
SET deletedAt = NULL
WHERE flashcardId = :flashcardId
  AND deletedAt = :deletedAt;
