CREATE TABLE Flashcard (
    appAccountId TEXT NOT NULL,
    id TEXT NOT NULL,                   -- UUID
    deckId TEXT NOT NULL,               -- FK → Decks.id

    word TEXT NOT NULL,                 -- Palabra clave ("compelling")
    meaning TEXT NOT NULL,              -- Explicación en inglés ("convincing")
    translation TEXT,                   -- Traducción en español ("convincente")

    phonetic TEXT,                      -- Pronunciación /kəmˈpelɪŋ/
    partOfSpeech TEXT,                  -- noun, verb, adjective, phrasal_verb, etc.
    type TEXT,                          -- word, phrase, idiom, phrasal_verb, sentence

    note TEXT,                          -- Nota personal / tips de gramática
    register TEXT,
    levelBand TEXT,
    domain TEXT,
    lemma TEXT,
    whyUseful TEXT,
    usagePattern TEXT,
    irregularFormsJson TEXT,
    collocationsJson TEXT,
    commonMistake TEXT,
    confusableWithJson TEXT,
    clozeSentence TEXT,
    sourceContext TEXT,
    warningsJson TEXT,
    studyCardsJson TEXT,
    qualityChecksJson TEXT,
    createdAt INTEGER NOT NULL,        -- Fecha de creación
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,
    originDeviceId TEXT NOT NULL,
    lastModifiedByDeviceId TEXT NOT NULL,
    versionLamport INTEGER NOT NULL,

    PRIMARY KEY (appAccountId, id),
    FOREIGN KEY (appAccountId, deckId) REFERENCES Deck(appAccountId, id) ON DELETE CASCADE
);

CREATE INDEX idx_Flashcard_account_deck_deleted ON Flashcard(appAccountId, deckId, deletedAt);
CREATE INDEX idx_Flashcard_account_deleted ON Flashcard(appAccountId, deletedAt);
CREATE INDEX idx_Flashcard_account_createdAt ON Flashcard(appAccountId, createdAt DESC);

create:
INSERT OR REPLACE INTO Flashcard (
    appAccountId,
    id,
    deckId,
    word,
    meaning,
    translation,
    phonetic,
    partOfSpeech,
    type,
    note,
    register,
    levelBand,
    domain,
    lemma,
    whyUseful,
    usagePattern,
    irregularFormsJson,
    collocationsJson,
    commonMistake,
    confusableWithJson,
    clozeSentence,
    sourceContext,
    warningsJson,
    studyCardsJson,
    qualityChecksJson,
    createdAt,
    updatedAt,
    deletedAt,
    originDeviceId,
    lastModifiedByDeviceId,
    versionLamport
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllFlashcards:
DELETE FROM Flashcard;

all:
SELECT * FROM Flashcard
WHERE appAccountId = ?
  AND deletedAt IS NULL;

findById:
SELECT * FROM Flashcard
WHERE appAccountId = ?
  AND id = ?;

selectByDeck:
SELECT * FROM Flashcard
WHERE appAccountId = ?
  AND deckId = ?
  AND deletedAt IS NULL;

flashcardWithExamples:
SELECT
    f.*,
    e.id AS exampleId,
    e.text AS exampleText,
    e.translation AS exampleTranslation,
    e.type AS exampleType
FROM Flashcard f
LEFT JOIN FlashcardExample e
  ON f.appAccountId = e.appAccountId
 AND f.id = e.flashcardId
 AND e.deletedAt IS NULL
WHERE f.appAccountId = :appAccountId
  AND f.id = :flashcardId
  AND f.deletedAt IS NULL;

flashcardsToReviewByDeck:
SELECT f.*, rp.*
FROM Flashcard f
LEFT JOIN ReviewProjection rp
  ON f.appAccountId = rp.appAccountId
 AND f.id = rp.flashcardId
WHERE f.appAccountId = :appAccountId
  AND f.deckId = :deckId
  AND f.deletedAt IS NULL
  AND (rp.nextReviewAt IS NULL OR rp.nextReviewAt <= :now);

flashcardsWithReview:
SELECT f.*, rp.nextReviewAt
FROM Flashcard f
LEFT JOIN ReviewProjection rp
  ON f.appAccountId = rp.appAccountId
 AND f.id = rp.flashcardId
WHERE f.appAccountId = :appAccountId
  AND f.deckId = :deckId
  AND f.deletedAt IS NULL;
