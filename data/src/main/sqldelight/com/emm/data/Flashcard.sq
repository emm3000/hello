CREATE TABLE Flashcard (
    id TEXT NOT NULL,                   -- UUID
    deckId TEXT NOT NULL,               -- FK → Decks.id

    word TEXT NOT NULL,                 -- Palabra clave ("compelling")
    meaning TEXT NOT NULL,              -- Explicación en inglés ("convincing")
    translation TEXT,                   -- Traducción en español ("convincente")

    phonetic TEXT,                      -- Pronunciación /kəmˈpelɪŋ/
    partOfSpeech TEXT,                  -- noun, verb, adjective, phrasal_verb, etc.
    type TEXT,                          -- word, phrase, idiom, phrasal_verb, sentence

    note TEXT,                          -- Nota personal / tips de gramática
    register TEXT,
    levelBand TEXT,
    domain TEXT,
    lemma TEXT,
    whyUseful TEXT,
    usagePattern TEXT,
    irregularFormsJson TEXT,
    collocationsJson TEXT,
    commonMistake TEXT,
    confusableWithJson TEXT,
    clozeSentence TEXT,
    sourceContext TEXT,
    warningsJson TEXT,
    studyCardsJson TEXT,
    qualityChecksJson TEXT,
    createdAt INTEGER NOT NULL,        -- Fecha de creación
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,

    PRIMARY KEY (id),
    FOREIGN KEY (deckId) REFERENCES Deck(id) ON DELETE CASCADE
);

CREATE INDEX idx_Flashcard_deck_deleted ON Flashcard(deckId, deletedAt);
CREATE INDEX idx_Flashcard_deleted ON Flashcard(deletedAt);
CREATE INDEX idx_Flashcard_createdAt ON Flashcard(createdAt DESC);

create:
INSERT OR REPLACE INTO Flashcard (
    id,
    deckId,
    word,
    meaning,
    translation,
    phonetic,
    partOfSpeech,
    type,
    note,
    register,
    levelBand,
    domain,
    lemma,
    whyUseful,
    usagePattern,
    irregularFormsJson,
    collocationsJson,
    commonMistake,
    confusableWithJson,
    clozeSentence,
    sourceContext,
    warningsJson,
    studyCardsJson,
    qualityChecksJson,
    createdAt,
    updatedAt,
    deletedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllFlashcards:
DELETE FROM Flashcard;

all:
SELECT * FROM Flashcard
WHERE deletedAt IS NULL;

findById:
SELECT * FROM Flashcard
WHERE id = ?;

selectByDeck:
SELECT * FROM Flashcard
WHERE deckId = ?
  AND deletedAt IS NULL;

existsExactDuplicate:
SELECT EXISTS(
  SELECT 1 FROM Flashcard
  WHERE deckId = :deckId
    AND deletedAt IS NULL
    AND lower(trim(word)) = :normalizedExpression
    AND lower(trim(translation)) = :normalizedIntendedMeaningEs
    AND lower(trim(type)) = :normalizedNoteType
);

flashcardWithExamples:
SELECT
    f.*,
    e.id AS exampleId,
    e.text AS exampleText,
    e.translation AS exampleTranslation,
    e.type AS exampleType
FROM Flashcard f
LEFT JOIN FlashcardExample e
  ON f.id = e.flashcardId
  AND e.deletedAt IS NULL
WHERE f.id = :flashcardId
  AND f.deletedAt IS NULL;

flashcardsToReviewByDeck:
SELECT f.*, rp.*
FROM Flashcard f
LEFT JOIN ReviewProjection rp
  ON f.id = rp.flashcardId
WHERE f.deckId = :deckId
  AND f.deletedAt IS NULL
  AND (rp.nextReviewAt IS NULL OR rp.nextReviewAt <= :now);

flashcardsWithReview:
SELECT f.*, rp.nextReviewAt, rp.lastReviewedAt
FROM Flashcard f
LEFT JOIN ReviewProjection rp
  ON f.id = rp.flashcardId
WHERE f.deckId = :deckId
  AND f.deletedAt IS NULL;

countDueFlashcards:
SELECT COUNT(*)
FROM Flashcard f
LEFT JOIN ReviewProjection rp
  ON f.id = rp.flashcardId
WHERE f.deletedAt IS NULL
  AND (rp.nextReviewAt IS NULL OR rp.nextReviewAt <= :now);

update:
UPDATE Flashcard
SET word = :word,
    meaning = :meaning,
    translation = :translation,
    phonetic = :phonetic,
    partOfSpeech = :partOfSpeech,
    type = :type,
    note = :note,
    register = :register,
    levelBand = :levelBand,
    domain = :domain,
    lemma = :lemma,
    whyUseful = :whyUseful,
    usagePattern = :usagePattern,
    irregularFormsJson = :irregularFormsJson,
    collocationsJson = :collocationsJson,
    commonMistake = :commonMistake,
    confusableWithJson = :confusableWithJson,
    clozeSentence = :clozeSentence,
    sourceContext = :sourceContext,
    warningsJson = :warningsJson,
    updatedAt = :updatedAt
WHERE id = :id
  AND deletedAt IS NULL;

softDelete:
UPDATE Flashcard
SET deletedAt = :now
WHERE id = :id
  AND deletedAt IS NULL;

softDeleteExamplesByFlashcard:
UPDATE FlashcardExample
SET deletedAt = :now
WHERE flashcardId = :flashcardId
  AND deletedAt IS NULL;

restoreFlashcard:
UPDATE Flashcard
SET deletedAt = NULL
WHERE id = :id
  AND deletedAt = :deletedAt;

restoreExamplesByFlashcard:
UPDATE FlashcardExample
SET deletedAt = NULL
WHERE flashcardId = :flashcardId
  AND deletedAt = :deletedAt;
