CREATE TABLE Flashcard (
    id TEXT NOT NULL PRIMARY KEY,       -- UUID
    deckId TEXT NOT NULL,              -- FK → Decks.id

    word TEXT NOT NULL,                 -- Palabra clave ("compelling")
    meaning TEXT NOT NULL,              -- Explicación en inglés ("convincing")
    translation TEXT,                   -- Traducción en español ("convincente")

    phonetic TEXT,                      -- Pronunciación /kəmˈpelɪŋ/
    audioPath TEXT,                    -- Ruta local (opcional)
    imagePath TEXT,                    -- Ruta a imagen local (opcional)

    note TEXT,                          -- Nota personal del usuario
    createdAt INTEGER NOT NULL,        -- Fecha de creación
    updatedAt INTEGER NOT NULL,
    isGenerated INTEGER NOT NULL DEFAULT 0, -- 1 si fue generada por IA
    syncStatus TEXT NOT NULL,

    FOREIGN KEY (deckId) REFERENCES Deck(id) ON DELETE CASCADE
);

create:
INSERT OR REPLACE INTO Flashcard (id, deckId, word, meaning, translation, phonetic, createdAt, updatedAt, isGenerated, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?,?, 1, ?);

all:
SELECT * FROM Flashcard;

pending:
SELECT * FROM Flashcard WHERE syncStatus = 'Pending';

markAsSynced:
UPDATE Flashcard SET syncStatus = 'Synced' WHERE id IN ?;

selectByDeck:
SELECT * FROM Flashcard WHERE deckId = ?;

flashcardWithExamples:
SELECT
    f.*,
    e.id AS exampleId,
    e.text AS exampleText,
    e.translation AS exampleTranslation,
    e.type AS exampleType
FROM Flashcard f
LEFT JOIN FlashcardExample e ON f.id = e.flashcardId
WHERE f.id = :flashcardId;