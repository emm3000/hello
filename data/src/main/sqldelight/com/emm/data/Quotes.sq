CREATE TABLE Quote (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    phrase TEXT NOT NULL,
    description TEXT NOT NULL,
    translation TEXT NOT NULL,
    example TEXT NOT NULL,
    context TEXT NOT NULL,
    pronunciation TEXT NOT NULL,
    formality TEXT NOT NULL,
    tags TEXT NOT NULL,
    category TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    syncStatus TEXT NOT NULL
);

insert:
INSERT OR REPLACE INTO Quote VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

all:
SELECT * FROM Quote ORDER BY createdAt DESC;

all2:
SELECT
    Quote.*,
    Flashcard.id IS NOT NULL AS hasCard
FROM Quote
LEFT JOIN Flashcard ON Flashcard.id = Quote.id;

pending:
SELECT * FROM Quote WHERE syncStatus = 'Pending';

markAsSynced:
UPDATE Quote SET syncStatus = 'Synced' WHERE id IN ?;

lastInsertedQuote:
SELECT *
FROM Quote
ORDER BY createdAt DESC
LIMIT 1;
