CREATE TABLE Quote (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    phrase TEXT NOT NULL,
    description TEXT NOT NULL,
    translation TEXT NOT NULL,
    example TEXT NOT NULL,
    context TEXT NOT NULL,
    pronunciation TEXT NOT NULL,
    formality TEXT NOT NULL,
    tags TEXT NOT NULL,
    category TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,
    originDeviceId TEXT NOT NULL,
    lastModifiedByDeviceId TEXT NOT NULL,
    versionLamport INTEGER NOT NULL
);

CREATE INDEX idx_Quote_createdAt ON Quote(createdAt DESC);
CREATE INDEX idx_Quote_deletedAt ON Quote(deletedAt);

insert:
INSERT OR REPLACE INTO Quote (
    id,
    title,
    phrase,
    description,
    translation,
    example,
    context,
    pronunciation,
    formality,
    tags,
    category,
    createdAt,
    updatedAt,
    deletedAt,
    originDeviceId,
    lastModifiedByDeviceId,
    versionLamport
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

all:
SELECT * FROM Quote ORDER BY createdAt DESC;

all2:
SELECT
    Quote.*,
    Flashcard.id IS NOT NULL AS hasCard
FROM Quote
LEFT JOIN Flashcard ON Flashcard.id = Quote.id
ORDER BY Quote.createdAt DESC;

lastInsertedQuote:
SELECT *
FROM Quote
ORDER BY createdAt DESC
LIMIT 1;
