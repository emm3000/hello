CREATE TABLE FlashcardReview (
    flashcardId TEXT NOT NULL PRIMARY KEY,  -- Igual a Flashcards.id (1:1)

    lastReviewedAt INTEGER,  -- Último repaso (timestamp)
    nextReviewAt INTEGER,    -- Cuándo debe aparecer de nuevo
    easeFactor REAL NOT NULL DEFAULT 2.5, -- Dificultad (SM-2)
    interval INTEGER NOT NULL DEFAULT 0,   -- Días hasta el próximo repaso
    repetitions INTEGER NOT NULL DEFAULT 0, -- Veces seguidas correctas
    lapses INTEGER NOT NULL DEFAULT 0,       -- Fallos

    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,

    FOREIGN KEY (flashcardId) REFERENCES Flashcard(id) ON DELETE CASCADE
);

CREATE INDEX idx_FlashcardReview_nextReviewAt ON FlashcardReview(nextReviewAt);

all:
SELECT * FROM FlashcardReview;

upsertFlashcardReview:
INSERT OR REPLACE INTO FlashcardReview (
    flashcardId,
    lastReviewedAt,
    nextReviewAt,
    easeFactor,
    interval,
    repetitions,
    lapses,
    createdAt,
    updatedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE FlashcardReview SET
    lastReviewedAt = ?,
    nextReviewAt = ?,
    easeFactor = ?,
    interval = ?,
    repetitions = ?,
    lapses = ?
WHERE flashcardId = ?;
