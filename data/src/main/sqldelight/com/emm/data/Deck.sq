CREATE TABLE Deck (
    appAccountId TEXT NOT NULL,
    id TEXT NOT NULL,             -- UUID
    name TEXT NOT NULL,           -- Ej: "Frases de viaje", "Nivel A1"
    description TEXT,             -- Explicación opcional
    createdAt INTEGER NOT NULL,   -- Timestamp (Unix epoch millis)
    updatedAt INTEGER NOT NULL,   -- Timestamp (Unix epoch millis)
    deletedAt INTEGER,
    originDeviceId TEXT NOT NULL,
    lastModifiedByDeviceId TEXT NOT NULL,
    versionLamport INTEGER NOT NULL,
    PRIMARY KEY (appAccountId, id)
);

CREATE INDEX idx_Deck_account_createdAt ON Deck(appAccountId, createdAt DESC);
CREATE INDEX idx_Deck_account_deletedAt ON Deck(appAccountId, deletedAt);

all:
SELECT * FROM Deck
WHERE appAccountId = ?
  AND deletedAt IS NULL
ORDER BY createdAt DESC;

findById:
SELECT * FROM Deck
WHERE appAccountId = ?
  AND id = ?;

findActiveById:
SELECT * FROM Deck
WHERE appAccountId = ?
  AND id = ?
  AND deletedAt IS NULL;

insert:
INSERT OR REPLACE INTO Deck (
    appAccountId,
    id,
    name,
    description,
    createdAt,
    updatedAt,
    deletedAt,
    originDeviceId,
    lastModifiedByDeviceId,
    versionLamport
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllDecks:
DELETE FROM Deck;

deckWithFlashcardCount:
SELECT Deck.*, COUNT(Flashcard.id) AS flashcardCount
FROM Deck
LEFT JOIN Flashcard
  ON Flashcard.appAccountId = Deck.appAccountId
 AND Flashcard.deckId = Deck.id
 AND Flashcard.deletedAt IS NULL
WHERE Deck.appAccountId = ?
  AND Deck.deletedAt IS NULL
GROUP BY Deck.appAccountId, Deck.id
ORDER BY Deck.createdAt DESC;
