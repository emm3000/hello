CREATE TABLE Deck (
    id TEXT NOT NULL PRIMARY KEY, -- UUID
    name TEXT NOT NULL,           -- Ej: "Frases de viaje", "Nivel A1"
    description TEXT,             -- Explicación opcional
    createdAt INTEGER NOT NULL   -- Timestamp (Unix epoch millis)
);

all:
SELECT * FROM Deck;

findById:
SELECT * FROM Deck WHERE id = ?;

insert:
INSERT OR REPLACE INTO Deck VALUES (?, ?, ?, ?);