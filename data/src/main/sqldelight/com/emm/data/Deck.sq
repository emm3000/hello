CREATE TABLE Deck (
    id TEXT NOT NULL PRIMARY KEY, -- UUID
    name TEXT NOT NULL,           -- Ej: "Frases de viaje", "Nivel A1"
    description TEXT,             -- Explicación opcional
    createdAt INTEGER NOT NULL,   -- Timestamp (Unix epoch millis)
    updatedAt INTEGER NOT NULL,   -- Timestamp (Unix epoch millis)
    syncStatus TEXT NOT NULL
);

CREATE INDEX idx_Deck_syncStatus ON Deck(syncStatus);
CREATE INDEX idx_Deck_createdAt ON Deck(createdAt DESC);

all:
SELECT * FROM Deck;

pending:
SELECT * FROM Deck WHERE syncStatus = 'Pending';

markAsSynced:
UPDATE Deck SET syncStatus = 'Synced' WHERE id IN ?;

findById:
SELECT * FROM Deck WHERE id = ?;

insert:
INSERT OR REPLACE INTO Deck VALUES (?, ?, ?, ?, ?, ?);

deckWithFlashcardCount:
SELECT Deck.*, COUNT(Flashcard.id) AS flashcardCount
FROM Deck
LEFT JOIN Flashcard ON Flashcard.deckId = Deck.id
GROUP BY Deck.id
ORDER BY Deck.createdAt DESC;
