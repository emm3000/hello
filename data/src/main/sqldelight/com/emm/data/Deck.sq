CREATE TABLE Deck (
    id TEXT NOT NULL,             -- UUID
    name TEXT NOT NULL,           -- Ej: "Frases de viaje", "Nivel A1"
    description TEXT,             -- Explicación opcional
    createdAt INTEGER NOT NULL,   -- Timestamp (Unix epoch millis)
    updatedAt INTEGER NOT NULL,   -- Timestamp (Unix epoch millis)
    deletedAt INTEGER,
    PRIMARY KEY (id)
);

CREATE INDEX idx_Deck_createdAt ON Deck(createdAt DESC);
CREATE INDEX idx_Deck_deletedAt ON Deck(deletedAt);
CREATE INDEX idx_Deck_name ON Deck(name);

all:
SELECT * FROM Deck
WHERE deletedAt IS NULL
ORDER BY createdAt DESC;

findById:
SELECT * FROM Deck
WHERE id = ?;

findActiveById:
SELECT * FROM Deck
WHERE id = ?
  AND deletedAt IS NULL;

insert:
INSERT OR REPLACE INTO Deck (
    id,
    name,
    description,
    createdAt,
    updatedAt,
    deletedAt
) VALUES (?, ?, ?, ?, ?, ?);

deleteAllDecks:
DELETE FROM Deck;

deckWithFlashcardCount:
SELECT Deck.*, COUNT(Flashcard.id) AS flashcardCount
FROM Deck
LEFT JOIN Flashcard
  ON Flashcard.deckId = Deck.id
  AND Flashcard.deletedAt IS NULL
WHERE Deck.deletedAt IS NULL
GROUP BY Deck.id
ORDER BY Deck.createdAt DESC;

tagsForDeck:
SELECT t.* FROM Tag t
JOIN DeckTag dt ON dt.tagId = t.id
WHERE dt.deckId = ? AND t.deletedAt IS NULL;

observeFiltered:
SELECT
    Deck.id,
    Deck.name,
    Deck.description,
    Deck.createdAt,
    COUNT(DISTINCT Flashcard.id) AS flashcardCount,
    COALESCE(GROUP_CONCAT(DISTINCT Tag.name), '') AS tagsCsv
FROM Deck
LEFT JOIN Flashcard
  ON Flashcard.deckId = Deck.id
  AND Flashcard.deletedAt IS NULL
LEFT JOIN DeckTag
  ON DeckTag.deckId = Deck.id
LEFT JOIN Tag
  ON Tag.id = DeckTag.tagId
  AND Tag.deletedAt IS NULL
WHERE Deck.deletedAt IS NULL
  AND (:query = '' OR LOWER(Deck.name) LIKE '%' || :query || '%')
  AND (
    :selectedTagCount = 0
    OR Deck.id IN (
      SELECT dtf.deckId
      FROM DeckTag AS dtf
      JOIN Tag AS tf
        ON tf.id = dtf.tagId
        AND tf.deletedAt IS NULL
      WHERE LOWER(tf.name) IN :normalizedTagNames
      GROUP BY dtf.deckId
      HAVING COUNT(DISTINCT LOWER(tf.name)) = :selectedTagCount
    )
  )
GROUP BY Deck.id
ORDER BY Deck.createdAt DESC;
