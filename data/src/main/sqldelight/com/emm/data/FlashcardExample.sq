CREATE TABLE FlashcardExample (
    appAccountId TEXT NOT NULL,
    id TEXT NOT NULL,
    flashcardId TEXT NOT NULL,
    text TEXT NOT NULL,
    translation TEXT NOT NULL,
    type TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,
    originDeviceId TEXT NOT NULL,
    lastModifiedByDeviceId TEXT NOT NULL,
    versionLamport INTEGER NOT NULL,
    PRIMARY KEY (appAccountId, id),
    FOREIGN KEY (appAccountId, flashcardId) REFERENCES Flashcard(appAccountId, id) ON DELETE CASCADE
);

CREATE INDEX idx_FlashcardExample_account_flashcard_deleted
ON FlashcardExample(appAccountId, flashcardId, deletedAt);

insert:
INSERT OR REPLACE INTO FlashcardExample (
    appAccountId,
    id,
    flashcardId,
    text,
    translation,
    type,
    createdAt,
    updatedAt,
    deletedAt,
    originDeviceId,
    lastModifiedByDeviceId,
    versionLamport
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllFlashcardExamples:
DELETE FROM FlashcardExample;

all:
SELECT * FROM FlashcardExample;

findById:
SELECT * FROM FlashcardExample
WHERE appAccountId = ?
  AND id = ?;
