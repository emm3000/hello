CREATE TABLE FlashcardExample (
    id TEXT PRIMARY KEY,
    flashcardId TEXT NOT NULL REFERENCES Flashcard(id) ON DELETE CASCADE,
    text TEXT NOT NULL,
    translation TEXT NOT NULL,
    type TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    syncStatus TEXT NOT NULL
);

CREATE INDEX idx_FlashcardExample_flashcardId ON FlashcardExample(flashcardId);
CREATE INDEX idx_FlashcardExample_syncStatus ON FlashcardExample(syncStatus);

insert:
INSERT OR REPLACE INTO FlashcardExample VALUES (?, ?, ?, ?, ?, ?, ?, ?);

pending:
SELECT * FROM FlashcardExample WHERE syncStatus = 'Pending';

markAsSynced:
UPDATE FlashcardExample SET syncStatus = 'Synced' WHERE id IN ?;

all:
SELECT * FROM FlashcardExample;
