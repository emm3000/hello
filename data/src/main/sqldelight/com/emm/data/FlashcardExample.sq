CREATE TABLE FlashcardExample (
    id TEXT PRIMARY KEY,
    flashcardId TEXT NOT NULL REFERENCES Flashcard(id) ON DELETE CASCADE,
    text TEXT NOT NULL,
    translation TEXT NOT NULL,
    type TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,
    originDeviceId TEXT NOT NULL,
    lastModifiedByDeviceId TEXT NOT NULL,
    versionLamport INTEGER NOT NULL
);

CREATE INDEX idx_FlashcardExample_flashcardId ON FlashcardExample(flashcardId);
CREATE INDEX idx_FlashcardExample_deletedAt ON FlashcardExample(deletedAt);

insert:
INSERT OR REPLACE INTO FlashcardExample (
    id,
    flashcardId,
    text,
    translation,
    type,
    createdAt,
    updatedAt,
    deletedAt,
    originDeviceId,
    lastModifiedByDeviceId,
    versionLamport
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllFlashcardExamples:
DELETE FROM FlashcardExample;

all:
SELECT * FROM FlashcardExample;

findById:
SELECT * FROM FlashcardExample
WHERE id = ?;
