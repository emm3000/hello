CREATE TABLE FlashcardExample (
    id TEXT NOT NULL,
    flashcardId TEXT NOT NULL,
    text TEXT NOT NULL,
    translation TEXT NOT NULL,
    type TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,
    PRIMARY KEY (id),
    FOREIGN KEY (flashcardId) REFERENCES Flashcard(id) ON DELETE CASCADE
);

CREATE INDEX idx_FlashcardExample_flashcard_deleted
ON FlashcardExample(flashcardId, deletedAt);

insert:
INSERT OR REPLACE INTO FlashcardExample (
    id,
    flashcardId,
    text,
    translation,
    type,
    createdAt,
    updatedAt,
    deletedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteAllFlashcardExamples:
DELETE FROM FlashcardExample;

all:
SELECT * FROM FlashcardExample;

findById:
SELECT * FROM FlashcardExample
WHERE id = ?;
