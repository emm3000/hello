CREATE TABLE LocalDeviceIdentity (
    singletonId INTEGER NOT NULL PRIMARY KEY CHECK (singletonId = 1),
    deviceId TEXT NOT NULL UNIQUE,
    installId TEXT NOT NULL UNIQUE,
    lamportCounter INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

selectLocalDeviceIdentity:
SELECT * FROM LocalDeviceIdentity WHERE singletonId = 1;

upsertLocalDeviceIdentity:
INSERT OR REPLACE INTO LocalDeviceIdentity (
    singletonId,
    deviceId,
    installId,
    lamportCounter,
    createdAt,
    updatedAt
) VALUES (1, ?, ?, ?, ?, ?);

-- Inserts only if the row does not exist yet (singletonId = 1 constraint).
-- Safe to call concurrently: a second INSERT is a no-op, preventing duplicate device IDs.
insertDeviceIdentityIfAbsent:
INSERT OR IGNORE INTO LocalDeviceIdentity (
    singletonId,
    deviceId,
    installId,
    lamportCounter,
    createdAt,
    updatedAt
) VALUES (1, ?, ?, 0, ?, ?);

currentLamport:
SELECT lamportCounter FROM LocalDeviceIdentity WHERE singletonId = 1;

CREATE TABLE ReviewEvent (
    eventId TEXT NOT NULL,
    flashcardId TEXT NOT NULL,
    grade TEXT NOT NULL,
    reviewedAt INTEGER NOT NULL,
    nextReviewAt INTEGER NOT NULL,
    easeFactor REAL NOT NULL,
    interval INTEGER NOT NULL,
    repetitions INTEGER NOT NULL,
    lapses INTEGER NOT NULL,
    createdAt INTEGER NOT NULL,
    -- FSRS-6 (schema v2): real review grade; 1=AGAIN,2=HARD,3=GOOD,4=EASY; 0=legacy rows.
    rating INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (eventId),
    FOREIGN KEY (flashcardId) REFERENCES Flashcard(id) ON DELETE CASCADE
);

CREATE INDEX idx_ReviewEvent_flashcard_reviewedAt
ON ReviewEvent(flashcardId, reviewedAt DESC);
CREATE INDEX idx_ReviewEvent_createdAt ON ReviewEvent(createdAt DESC);

insertReviewEvent:
INSERT INTO ReviewEvent (
    eventId,
    flashcardId,
    grade,
    reviewedAt,
    nextReviewAt,
    easeFactor,
    interval,
    repetitions,
    lapses,
    createdAt,
    rating
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
-- rating: the real ReviewGrade.toFsrsRating() value (1..4); 0 for legacy/unknown rows only.

findReviewEventById:
SELECT * FROM ReviewEvent
WHERE eventId = ?;

findReviewEventsByFlashcardId:
SELECT * FROM ReviewEvent
WHERE flashcardId = ?
ORDER BY reviewedAt DESC;

CREATE TABLE ReviewProjection (
    flashcardId TEXT NOT NULL,
    lastReviewedAt INTEGER NOT NULL,
    nextReviewAt INTEGER NOT NULL,
    easeFactor REAL NOT NULL,
    interval INTEGER NOT NULL,
    repetitions INTEGER NOT NULL,
    lapses INTEGER NOT NULL,
    sourceEventId TEXT NOT NULL,
    updatedAt INTEGER NOT NULL,
    -- FSRS-6 (schema v2): card state + seeded stability/difficulty from SM-2 fields.
    state TEXT NOT NULL DEFAULT 'NEW',
    stability REAL NOT NULL DEFAULT 0.0,
    difficulty REAL NOT NULL DEFAULT 0.0,
    PRIMARY KEY (flashcardId),
    FOREIGN KEY (flashcardId) REFERENCES Flashcard(id) ON DELETE CASCADE,
    FOREIGN KEY (sourceEventId) REFERENCES ReviewEvent(eventId) ON DELETE CASCADE
);

CREATE INDEX idx_ReviewProjection_nextReviewAt
ON ReviewProjection(nextReviewAt);

-- Inserts a brand-new ReviewProjection row with every FSRS-relevant column (including
-- state/stability/difficulty). No-op if a row already exists for this flashcard — paired with
-- updateReviewProjectionFull inside a transaction (real review-write path,
-- DefaultFlashcardReviewRepository), which always supplies the scheduler's freshly computed
-- FsrsCard fields. SQLDelight's bundled SQLite dialect predates native UPSERT (3.24+), hence the
-- two-statement insert-if-absent + unconditional-update pattern instead of ON CONFLICT.
insertReviewProjectionFullIfAbsent:
INSERT OR IGNORE INTO ReviewProjection (
    flashcardId,
    lastReviewedAt,
    nextReviewAt,
    easeFactor,
    interval,
    repetitions,
    lapses,
    sourceEventId,
    updatedAt,
    state,
    stability,
    difficulty
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Unconditionally overwrites every FSRS-relevant column on an existing ReviewProjection row.
updateReviewProjectionFull:
UPDATE ReviewProjection
SET
    lastReviewedAt = ?,
    nextReviewAt = ?,
    easeFactor = ?,
    interval = ?,
    repetitions = ?,
    lapses = ?,
    sourceEventId = ?,
    updatedAt = ?,
    state = ?,
    stability = ?,
    difficulty = ?
WHERE flashcardId = ?;

-- Full insert used by the backup-import path (table is cleared before import, so no conflict occurs).
-- Accepts all FSRS columns explicitly so backup-serialized state/stability/difficulty are preserved.
insertReviewProjectionFull:
INSERT INTO ReviewProjection (
    flashcardId,
    lastReviewedAt,
    nextReviewAt,
    easeFactor,
    interval,
    repetitions,
    lapses,
    sourceEventId,
    updatedAt,
    state,
    stability,
    difficulty
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

findReviewProjectionByFlashcardId:
SELECT * FROM ReviewProjection
WHERE flashcardId = ?;

allReviewProjections:
SELECT * FROM ReviewProjection;

-- Count distinct flashcards reviewed within a date range.
countDistinctCardsStudiedInRange:
SELECT COUNT(DISTINCT flashcardId) FROM ReviewEvent
WHERE reviewedAt >= :startMillis AND reviewedAt < :endMillis;

-- Count flashcards due at or before a specific moment.
-- LEFT JOIN includes never-reviewed cards (no ReviewProjection row): NULL nextReviewAt means due now.
-- Excludes soft-deleted flashcards.
countCardsDueBy:
SELECT COUNT(*) FROM Flashcard f
LEFT JOIN ReviewProjection rp ON f.id = rp.flashcardId
WHERE f.deletedAt IS NULL
  AND f.enrichmentStatus = 'ENRICHED'
  AND (rp.nextReviewAt IS NULL OR rp.nextReviewAt <= :nowMillis);

-- Count flashcards due within a future window [nowMillis, endMillis).
-- NULL nextReviewAt (never reviewed) means the card is overdue, not scheduled in the future window,
-- so the NULL branch is intentionally excluded here. Only explicitly scheduled future cards count.
-- Excludes soft-deleted flashcards.
countCardsDueInRange:
SELECT COUNT(*) FROM Flashcard f
LEFT JOIN ReviewProjection rp ON f.id = rp.flashcardId
WHERE f.deletedAt IS NULL
  AND f.enrichmentStatus = 'ENRICHED'
  AND rp.nextReviewAt >= :nowMillis AND rp.nextReviewAt < :endMillis;

-- Return distinct review dates (as epoch millis at start-of-day) in descending order.
-- Each row is the start-of-day in millis for a day that has at least one review.
distinctReviewDatesDescending:
SELECT DISTINCT (reviewedAt / 86400000) * 86400000 AS reviewDayMillis
FROM ReviewEvent
ORDER BY reviewDayMillis DESC;
