CREATE TABLE LocalDeviceIdentity (
    singletonId INTEGER NOT NULL PRIMARY KEY CHECK (singletonId = 1),
    deviceId TEXT NOT NULL UNIQUE,
    installId TEXT NOT NULL UNIQUE,
    lamportCounter INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

selectLocalDeviceIdentity:
SELECT * FROM LocalDeviceIdentity WHERE singletonId = 1;

upsertLocalDeviceIdentity:
INSERT OR REPLACE INTO LocalDeviceIdentity (
    singletonId,
    deviceId,
    installId,
    lamportCounter,
    createdAt,
    updatedAt
) VALUES (1, ?, ?, ?, ?, ?);

-- Inserts only if the row does not exist yet (singletonId = 1 constraint).
-- Safe to call concurrently: a second INSERT is a no-op, preventing duplicate device IDs.
insertDeviceIdentityIfAbsent:
INSERT OR IGNORE INTO LocalDeviceIdentity (
    singletonId,
    deviceId,
    installId,
    lamportCounter,
    createdAt,
    updatedAt
) VALUES (1, ?, ?, 0, ?, ?);

incrementLamport:
UPDATE LocalDeviceIdentity
SET lamportCounter = lamportCounter + 1, updatedAt = ?
WHERE singletonId = 1;

-- Advances the local Lamport counter to at least `minValue`.
-- Called after applying remote operations so local causality is maintained:
-- any subsequent local write will have a lamport > max seen remote lamport.
advanceLamportTo:
UPDATE LocalDeviceIdentity
SET lamportCounter = MAX(lamportCounter, ?), updatedAt = ?
WHERE singletonId = 1;

currentLamport:
SELECT lamportCounter FROM LocalDeviceIdentity WHERE singletonId = 1;

CREATE TABLE LocalAccountState (
    singletonId INTEGER NOT NULL PRIMARY KEY CHECK (singletonId = 1),
    appAccountId TEXT,
    authUserId TEXT,
    pairingState TEXT NOT NULL DEFAULT 'Unpaired',
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

selectLocalAccountState:
SELECT * FROM LocalAccountState WHERE singletonId = 1;

upsertLocalAccountState:
INSERT OR REPLACE INTO LocalAccountState (
    singletonId,
    appAccountId,
    authUserId,
    pairingState,
    createdAt,
    updatedAt
) VALUES (1, ?, ?, ?, ?, ?);

CREATE TABLE OperationLog (
    opId TEXT NOT NULL PRIMARY KEY,
    appAccountId TEXT NOT NULL,
    entityType TEXT NOT NULL,
    entityId TEXT NOT NULL,
    operationType TEXT NOT NULL,
    payload TEXT NOT NULL,
    lamport INTEGER NOT NULL,
    originDeviceId TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    status TEXT NOT NULL,
    retryCount INTEGER NOT NULL DEFAULT 0,
    lastAttemptAt INTEGER,
    lastError TEXT
);

CREATE INDEX idx_OperationLog_account_status_lamport_createdAt
ON OperationLog(appAccountId, status, lamport, createdAt);
CREATE INDEX idx_OperationLog_account_entityType_entityId
ON OperationLog(appAccountId, entityType, entityId);

insertOperation:
INSERT INTO OperationLog (
    opId,
    appAccountId,
    entityType,
    entityId,
    operationType,
    payload,
    lamport,
    originDeviceId,
    createdAt,
    status,
    retryCount,
    lastAttemptAt,
    lastError
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

pendingOperations:
SELECT * FROM OperationLog
WHERE appAccountId = :appAccountId
  AND status IN ('Pending', 'Failed')
  AND retryCount < :maxRetries
ORDER BY lamport ASC, createdAt ASC
LIMIT :limit;

countPendingOperations:
SELECT COUNT(*) FROM OperationLog
WHERE appAccountId = :appAccountId
  AND status = 'Pending';

countRetryableOperations:
SELECT COUNT(*) FROM OperationLog
WHERE appAccountId = :appAccountId
  AND status IN ('Pending', 'Failed')
  AND retryCount < :maxRetries;

markOperationAcked:
UPDATE OperationLog
SET status = 'Acked', lastAttemptAt = ?, lastError = NULL
WHERE opId = ?;

markOperationFailed:
UPDATE OperationLog
SET
    status = 'Failed',
    retryCount = retryCount + 1,
    lastAttemptAt = ?,
    lastError = ?
WHERE opId = ?;

markOperationDead:
UPDATE OperationLog
SET
    status = 'Dead',
    lastAttemptAt = ?,
    lastError = ?
WHERE opId = ?;

CREATE TABLE SyncCheckpoint (
    appAccountId TEXT NOT NULL PRIMARY KEY,
    lastPulledCursor INTEGER NOT NULL DEFAULT 0,
    lastSuccessfulSyncAt INTEGER,
    lastSyncError TEXT,
    lastSyncErrorAt INTEGER,
    updatedAt INTEGER NOT NULL
);

selectSyncCheckpoint:
SELECT * FROM SyncCheckpoint WHERE appAccountId = ?;

upsertSyncCheckpoint:
INSERT OR REPLACE INTO SyncCheckpoint (
    appAccountId,
    lastPulledCursor,
    lastSuccessfulSyncAt,
    lastSyncError,
    lastSyncErrorAt,
    updatedAt
) VALUES (?, ?, ?, ?, ?, ?);

CREATE TABLE AppliedRemoteOperation (
    appAccountId TEXT NOT NULL,
    opId TEXT NOT NULL,
    cursor INTEGER NOT NULL,
    entityType TEXT NOT NULL,
    entityId TEXT NOT NULL,
    operationType TEXT NOT NULL,
    processedAt INTEGER NOT NULL,
    PRIMARY KEY (appAccountId, opId)
);

CREATE INDEX idx_AppliedRemoteOperation_account_cursor
ON AppliedRemoteOperation(appAccountId, cursor DESC);

markRemoteOperationProcessed:
INSERT OR REPLACE INTO AppliedRemoteOperation (
    appAccountId,
    opId,
    cursor,
    entityType,
    entityId,
    operationType,
    processedAt
) VALUES (?, ?, ?, ?, ?, ?, ?);

findProcessedRemoteOperation:
SELECT * FROM AppliedRemoteOperation
WHERE appAccountId = ?
  AND opId = ?;

deleteAllOperations:
DELETE FROM OperationLog;

deleteAllAppliedRemoteOperations:
DELETE FROM AppliedRemoteOperation;

deleteAllReviewEvents:
DELETE FROM ReviewEvent;

deleteAllReviewProjections:
DELETE FROM ReviewProjection;

resetSyncCheckpoint:
DELETE FROM SyncCheckpoint;

CREATE TABLE ReviewEvent (
    eventId TEXT NOT NULL,
    flashcardId TEXT NOT NULL,
    grade TEXT NOT NULL,
    reviewedAt INTEGER NOT NULL,
    nextReviewAt INTEGER NOT NULL,
    easeFactor REAL NOT NULL,
    interval INTEGER NOT NULL,
    repetitions INTEGER NOT NULL,
    lapses INTEGER NOT NULL,
    createdAt INTEGER NOT NULL,
    -- FSRS-6 (schema v2): real review grade; 1=AGAIN,2=HARD,3=GOOD,4=EASY; 0=legacy rows.
    rating INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (eventId),
    FOREIGN KEY (flashcardId) REFERENCES Flashcard(id) ON DELETE CASCADE
);

CREATE INDEX idx_ReviewEvent_flashcard_reviewedAt
ON ReviewEvent(flashcardId, reviewedAt DESC);
CREATE INDEX idx_ReviewEvent_createdAt ON ReviewEvent(createdAt DESC);

insertReviewEvent:
INSERT INTO ReviewEvent (
    eventId,
    flashcardId,
    grade,
    reviewedAt,
    nextReviewAt,
    easeFactor,
    interval,
    repetitions,
    lapses,
    createdAt,
    rating
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
-- rating: pass the real ReviewGrade ordinal (1..4) in PR3; pass 0 for legacy/unknown in the interim.

findReviewEventById:
SELECT * FROM ReviewEvent
WHERE eventId = ?;

findReviewEventsByFlashcardId:
SELECT * FROM ReviewEvent
WHERE flashcardId = ?
ORDER BY reviewedAt DESC;

CREATE TABLE ReviewProjection (
    flashcardId TEXT NOT NULL,
    lastReviewedAt INTEGER NOT NULL,
    nextReviewAt INTEGER NOT NULL,
    easeFactor REAL NOT NULL,
    interval INTEGER NOT NULL,
    repetitions INTEGER NOT NULL,
    lapses INTEGER NOT NULL,
    sourceEventId TEXT NOT NULL,
    updatedAt INTEGER NOT NULL,
    -- FSRS-6 (schema v2): card state + seeded stability/difficulty from SM-2 fields.
    state TEXT NOT NULL DEFAULT 'NEW',
    stability REAL NOT NULL DEFAULT 0.0,
    difficulty REAL NOT NULL DEFAULT 0.0,
    PRIMARY KEY (flashcardId),
    FOREIGN KEY (flashcardId) REFERENCES Flashcard(id) ON DELETE CASCADE,
    FOREIGN KEY (sourceEventId) REFERENCES ReviewEvent(eventId) ON DELETE CASCADE
);

CREATE INDEX idx_ReviewProjection_nextReviewAt
ON ReviewProjection(nextReviewAt);

-- Inserts a brand-new ReviewProjection row only if one does not already exist for this flashcard.
-- state/stability/difficulty use table DEFAULTs ('NEW'/0.0/0.0) so migration-seeded FSRS values
-- are never overwritten on an existing row.
-- Called together with updateReviewProjectionScheduling inside a transaction.
-- TODO(PR3/T-17): replace this pair with a full FSRS upsert once the scheduler provides real values.
insertReviewProjectionIfAbsent:
INSERT OR IGNORE INTO ReviewProjection (
    flashcardId,
    lastReviewedAt,
    nextReviewAt,
    easeFactor,
    interval,
    repetitions,
    lapses,
    sourceEventId,
    updatedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Updates only the SM-2/scheduling columns on an existing ReviewProjection row.
-- state/stability/difficulty are intentionally NOT touched so migration-seeded FSRS values survive.
updateReviewProjectionScheduling:
UPDATE ReviewProjection
SET
    lastReviewedAt = ?,
    nextReviewAt = ?,
    easeFactor = ?,
    interval = ?,
    repetitions = ?,
    lapses = ?,
    sourceEventId = ?,
    updatedAt = ?
WHERE flashcardId = ?;

-- Full insert used by the backup-import path (table is cleared before import, so no conflict occurs).
-- Accepts all FSRS columns explicitly so backup-serialized state/stability/difficulty are preserved.
insertReviewProjectionFull:
INSERT INTO ReviewProjection (
    flashcardId,
    lastReviewedAt,
    nextReviewAt,
    easeFactor,
    interval,
    repetitions,
    lapses,
    sourceEventId,
    updatedAt,
    state,
    stability,
    difficulty
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

findReviewProjectionByFlashcardId:
SELECT * FROM ReviewProjection
WHERE flashcardId = ?;

allReviewProjections:
SELECT * FROM ReviewProjection;

-- Count distinct flashcards reviewed within a date range.
countDistinctCardsStudiedInRange:
SELECT COUNT(DISTINCT flashcardId) FROM ReviewEvent
WHERE reviewedAt >= :startMillis AND reviewedAt < :endMillis;

-- Count flashcards due at or before a specific moment.
-- LEFT JOIN includes never-reviewed cards (no ReviewProjection row): NULL nextReviewAt means due now.
-- Excludes soft-deleted flashcards.
countCardsDueBy:
SELECT COUNT(*) FROM Flashcard f
LEFT JOIN ReviewProjection rp ON f.id = rp.flashcardId
WHERE f.deletedAt IS NULL
  AND (rp.nextReviewAt IS NULL OR rp.nextReviewAt <= :nowMillis);

-- Count flashcards due within a future window [nowMillis, endMillis).
-- NULL nextReviewAt (never reviewed) means the card is overdue, not scheduled in the future window,
-- so the NULL branch is intentionally excluded here. Only explicitly scheduled future cards count.
-- Excludes soft-deleted flashcards.
countCardsDueInRange:
SELECT COUNT(*) FROM Flashcard f
LEFT JOIN ReviewProjection rp ON f.id = rp.flashcardId
WHERE f.deletedAt IS NULL
  AND rp.nextReviewAt >= :nowMillis AND rp.nextReviewAt < :endMillis;

-- Return distinct review dates (as epoch millis at start-of-day) in descending order.
-- Each row is the start-of-day in millis for a day that has at least one review.
distinctReviewDatesDescending:
SELECT DISTINCT (reviewedAt / 86400000) * 86400000 AS reviewDayMillis
FROM ReviewEvent
ORDER BY reviewDayMillis DESC;
