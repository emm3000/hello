private const val BORDER_ANIMATION_MS: Int = 150
private const val DISABLED_ALPHA: Float = 0.38f
private val componentMinHeight: Dp = 48.dp

@Composable
fun H__Component__(
    label: String,
    onClick: () -> Unit,
    modifier: Modifier = Modifier,
    active: Boolean = false,
    enabled: Boolean = true,
) {
    val interactionSource: MutableInteractionSource = remember { MutableInteractionSource() }
    val isPressed: Boolean by interactionSource.collectIsPressedAsState()
    val shape: Shape = MaterialTheme.helloShapes.control

    val targetBorderColor: Color = when {
        !enabled -> hairline.copy(alpha = DISABLED_ALPHA)
        active || isPressed -> ink
        else -> hairline
    }

    val borderColor: Color by animateColorAsState(
        targetValue = targetBorderColor,
        animationSpec = tween(durationMillis = BORDER_ANIMATION_MS),
        label = "H__Component___border",
    )

    Box(
        modifier = modifier
            .defaultMinSize(minHeight = componentMinHeight)
            .clip(shape)
            .border(width = 1.dp, color = borderColor, shape = shape)
            .clickable(
                interactionSource = interactionSource,
                indication = null,
                enabled = enabled,
                onClick = onClick,
            )
            .padding(
                horizontal = MaterialTheme.spacing.md,
                vertical = MaterialTheme.spacing.sm,
            ),
        contentAlignment = Alignment.Center,
    ) {
        Text(
            text = label,
            style = MaterialTheme.typography.bodyMedium,
            color = if (enabled) ink else inkFaint,
        )
    }
}

@PreviewLightDark
@Composable
private fun H__Component__Preview() {
    HelloTheme {
        Surface(color = pageBackground) {
            Box(modifier = Modifier.padding(16.dp)) {
                H__Component__(
                    label = "__Component__",
                    onClick = {},
                )
            }
        }
    }
}

@PreviewLightDark
@Composable
private fun H__Component__ActivePreview() {
    HelloTheme {
        Surface(color = pageBackground) {
            Box(modifier = Modifier.padding(16.dp)) {
                H__Component__(
                    label = "__Component__",
                    onClick = {},
                    active = true,
                )
            }
        }
    }
}
